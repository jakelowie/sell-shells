# Leave unset to use the Vite proxy to http://localhost:3000 during local development.
# Set this when the frontend should call a different API origin.
# VITE_API_BASE_URL=https://api.example.com

# Browser-safe Supabase project settings. Never put SUPABASE_SECRET_KEY here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
