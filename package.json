{
  "name": "sell-shells",
  "version": "1.0.0",
  "private": true,
  "description": "A simple shell inventory API built with Express and TypeScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node dist/server.js",
    "test": "npm run build && node --experimental-test-isolation=none --test",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,cjs,json}\" \"frontend/src/**/*.{ts,tsx,js,cjs,css,json}\" \"frontend/vite.config.ts\" \"tests/**/*.{ts,tsx,js,cjs,json}\" \"mobile/app/**/*.{ts,tsx,js,jsx,json}\" \"mobile/src/**/*.{ts,tsx,js,jsx,json}\" \"*.json\" \"frontend/*.json\" \"mobile/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,cjs,json}\" \"frontend/src/**/*.{ts,tsx,js,cjs,css,json}\" \"frontend/vite.config.ts\" \"tests/**/*.{ts,tsx,js,cjs,json}\" \"mobile/app/**/*.{ts,tsx,js,jsx,json}\" \"mobile/src/**/*.{ts,tsx,js,jsx,json}\" \"*.json\" \"frontend/*.json\" \"mobile/*.json\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.9.3",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
